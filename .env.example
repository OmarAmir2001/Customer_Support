# This file contains environment variables for the Customer Support Agent With Escalation application.
APP_NAME=Customer Support Agent With Escalation
APP_VERSION=1.0.0
# Add any other environment variables you need for your application here. For example:
# DATABASE_URL="your_database_url_here"
# API_KEY="your_api_key_here"
GROQ_API_KEY=your_groq_api_key_here

# File Allowed Types and Size limits for file upload
# Default
FILE_ALLOWED_TYPES=["text/plain", "application/pdf","text/markdown","application/json"]
# 10 MB in bytes #Default
FILE_MAX_SIZE=10485760
# 500 KB in bytes #Default
FILE_DEFAULT_CHUNK_SIZE=512000
ASSETS_DIR=assets

POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=your postgres password here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE=your postgres database name here

#============================== LLM Configuration ==============================
# API_KEY="your_api_key_here"
GENERATION_BACKEND=OPENAI
EMBEDDING_BACKEND=COHERE

GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_URL=your_openai_api_url_here

# trial key
COHERE_API_KEY=your_cohere_api_key_here

# NOTE: the models this project was written against (llama-3.3-70b-versatile,
# llama-3.1-8b-instant) return 404 on this Groq account. The LITERAL list below is
# what the account actually serves. Symptom if you switch back to a 404 model:
# every question escalates, because the judges fail closed when the call errors.
GENERATION_MODEL_ID=openai/gpt-oss-120b
EMBEDDING_MODEL_ID=embed-multilingual-light-v3.0
EMBEDDING_MODEL_SIZE=384

# generate_text() runs its prompt through process_text(), which truncates to this
# many characters. The answer prompt carries the retrieved excerpts, so at the old
# 1024 the context was cut out of the prompt and the model answered from almost
# nothing. Keep this comfortably above (top_k x chunk_size).
INPUT_DEFAULT_MAX_CHARACTERS=8000
GENERATION_DEFAULT_MAX_TOKENS=800
GENERATION_DEFAULT_TEMPERATURE=0.1


#============================== Vector DB Configuration ==============================

# List settings are parsed as JSON, so these need double quotes, not single ones.
VECTOR_DB_BACKEND_LITERAL=["QDRANT","PGVECTOR"]
# Options: 'QDRANT', 'PGVECTOR'
VECTOR_DB_BACKEND=QDRANT
# Path to the vector database or 'pgvector_db' for PostgreSQL
VECTOR_DB_PATH=qdrant_db
# Options: 'cosine', 'dot'
VECTOR_DB_DISTANCE_METHOD=cosine
VECTOR_DB_PGVEC_INDEX_THRESHOLD=10000
# Must match EMBEDDING_MODEL_SIZE.
VECTOR_DB_DEFAULT_VECTOR_SIZE=384


#=========================== memory (Section 6) ================
MEMORY_ENABLED=true
# Extraction is an easy task; keep the big model for answering.
MEMORY_MODEL_ID=openai/gpt-oss-20b
MEMORY_MAX_OUTPUT_TOKENS=600
MEMORY_TEMPERATURE=0.0

#=========================== conversation history ==============
# Bounds the PROMPT. Storage is bounded separately by the messages reducer.
CONVERSATION_HISTORY_TURNS=6
CONVERSATION_HISTORY_MAX_CHARS=2000
CONVERSATION_HISTORY_MAX_CHARS_PER_TURN=400

#=========================== assistant identity ================
# The assistant's name, substituted into both locales' prompts.
ASSISTANT_NAME=Murshid

#=========================== logging ===========================
LOG_LEVEL=INFO
LOG_JSON=true

#=========================== retrieval =========================
KB_COLLECTION_NAME=collection_1
RETRIEVAL_TOP_K=5
# Over-fetch before department filtering and source re-ranking discard rows.
RETRIEVAL_OVERFETCH_FACTOR=3

#=========================== gates (Section 2) =================
# Starting values. Tune them against the labelled eval set.
GATE_CONTEXT_RELEVANCE_THRESHOLD=0.5
GATE_FAITHFULNESS_THRESHOLD=0.8
GATE_ANSWER_RELEVANCE_THRESHOLD=0.7

# A separate, cheaper model for the judges: they run up to three times per question.
JUDGE_MODEL_ID=openai/gpt-oss-20b
# gpt-oss models spend reasoning tokens before the JSON: a real judge call on 5
# handbook excerpts needs ~520 completion tokens, and at 300 the JSON is cut off
# mid-object, which Groq rejects outright as invalid JSON.
JUDGE_MAX_OUTPUT_TOKENS=1200
JUDGE_TEMPERATURE=0.0

# --- monitoring ---
# Grafana's initial admin account. Changed on first login in any real deployment;
# Grafana is bound to 127.0.0.1 so these never answer from outside.
# Note the exact spelling GF_USERS_ (plural) — Grafana ignores anything else, and a
# misspelled key silently leaves the setting at its default.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
