# This file contains environment variables for the Customer Support Agent With Escalation application.
APP_NAME="Customer Support Agent With Escalation"
APP_VERSION="0.1.0"
# Add any other environment variables you need for your application here. For example:
# DATABASE_URL="your_database_url_here"
# API_KEY="your_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

# File Allowed Types and Size limits for file upload
File_Allowed_Types=["text/plain", "application/pdf","text/markdown"] #Default
File_Max_Size=10485760  # 10 MB in bytes #Default
File_Default_CHUNK_SIZE=512000  # 500 KB in bytes #Default

MONGODB_URL="mongodb://localhost:27017" #Default
MONGODB_DATABASE="Customer-Support" #Default

#============================== LLM Configuration ==============================
# API_KEY="your_api_key_here"
GENERATION_BACKEND = 'OPENAI'
EMBEDDING_BACKEND = 'COHERE'

GROQ_API_KEY="your_groq_api_key_here"
OPENAI_API_URL="your_openai_api_url_here"

COHERE_API_KEY="your_cohere_api_key_here" #trial key

Generation_Model_ID="llama-3.3-70b-versatile"
EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE=384

INPUT_DEFAULT_MAX_CHARACTERS=1024
GENERATION_DEFAULT_MAX_TOKENS=200
GENERATION_DEFAULT_TEMPERATURE=0.1


#============================== Vector DB Configuration ==============================

VECTOR_DB_BACKEND = 'QDRANT'  # Options: 'QDRANT', 'PGVECTOR'
VECTOR_DB_PATH = "qdrant_db"  # Path to the vector database or 'pgvector_db' for PostgreSQL
VECTOR_DB_DISTANCE_METHOD = 'cosine'  # Options: 'cosine', 'dot'
