{
  "title": "Customer Support — API Overview",
  "uid": "cs-api-overview",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "type": "timeseries",
      "title": "Escalation rate",
      "description": "The share of questions sent to a human. HTTP panels stay green during the failure this catches: the judges fail closed, so a degraded provider escalates everything while /chat returns 200.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(customer_support_questions_total{outcome=\"escalated\"}[15m])) / clamp_min(sum(rate(customer_support_questions_total[15m])), 0.001)",
          "legendFormat": "escalated",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Judges failing closed",
      "description": "Judges that gave up after retries. The leading indicator: this moves BEFORE the escalation rate, and it is the only signal that separates a provider outage from genuinely bad retrieval — downstream both look identical.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (gate) (rate(customer_support_judge_failures_total[5m]))",
          "legendFormat": "{{gate}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "piechart",
      "title": "Why questions escalate",
      "description": "Which gate sent them to a human. context_relevance dominating means retrieval; the post-generation gates mean the answer was drafted but rejected.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (failed_gate) (customer_support_questions_total{outcome=\"escalated\"})",
          "legendFormat": "{{failed_gate}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by endpoint",
      "description": "Labelled by route template, so /api/v1/chat/{thread_id} is one series rather than one per conversation.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(customer_support_requests_total[5m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency by endpoint",
      "description": "Watch /api/v1/chat/{thread_id}: it reads through the LangGraph checkpointer, which is a single connection behind a global lock.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (endpoint, le) (rate(customer_support_request_latency_seconds_bucket[5m])))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate (5xx)",
      "description": "Counted in a finally block, so unhandled exceptions appear here rather than vanishing.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(customer_support_requests_total{status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Postgres connections in use",
      "description": "The budget is max_connections=100 against 5 uvicorn workers. Worth watching before it becomes an outage.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(pg_stat_database_numbackends)",
          "legendFormat": "connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Tokens per hour by model",
      "description": "Provider-reported usage, not an estimate from character counts — Arabic and English tokenise very differently in these models, so a character estimate would be wrong by a language-dependent factor. Streaming responses are NOT counted: usage needs stream_options, and risking the stream for a cost panel is the wrong trade.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (model) (rate(customer_support_tokens_total[5m])) * 3600",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Estimated cost per hour (USD)",
      "description": "Tokens/hour multiplied by the $price_in and $price_out dashboard constants at the top of this dashboard. Edit those when the rate card changes; nothing in the application needs redeploying. Input and output are priced separately because output is several times dearer, and a blended rate hides the one lever you have — answer length.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(customer_support_tokens_total{kind=\"prompt\"}[5m])) * 3600 * $price_in / 1e6",
          "legendFormat": "input",
          "refId": "A"
        },
        {
          "expr": "sum(rate(customer_support_tokens_total{kind=\"completion\"}[5m])) * 3600 * $price_out / 1e6",
          "legendFormat": "output",
          "refId": "B"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Query drift — cosine vs the eval-set centroid",
      "description": "Median and 5th percentile of how close each question sits to the evaluation set the gates and the chunking sweep were tuned on. FALLING means students are asking about things the handbook does not cover, which is a corpus problem — read it beside the escalation rate, because escalations rising with drift flat is a provider problem instead. The eval questions' own 5th percentile is 0.33 (see data/eval/drift_baseline.json), so sustained p5 below that is genuinely unusual traffic rather than noise.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.33
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(customer_support_query_drift_cosine_bucket[15m])))",
          "legendFormat": "median",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.05, sum by (le) (rate(customer_support_query_drift_cosine_bucket[15m])))",
          "legendFormat": "p5 (most unusual questions)",
          "refId": "B"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "price_in",
        "label": "USD per 1M input tokens",
        "type": "constant",
        "hide": 0,
        "query": "0.15",
        "current": {
          "text": "0.15",
          "value": "0.15"
        }
      },
      {
        "name": "price_out",
        "label": "USD per 1M output tokens",
        "type": "constant",
        "hide": 0,
        "query": "0.60",
        "current": {
          "text": "0.60",
          "value": "0.60"
        }
      }
    ]
  }
}
