{
  "title": "Customer Support — API Overview",
  "uid": "cs-api-overview",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "type": "timeseries",
      "title": "Escalation rate",
      "description": "The share of questions sent to a human. HTTP panels stay green during the failure this catches: the judges fail closed, so a degraded provider escalates everything while /chat returns 200.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(customer_support_questions_total{outcome=\"escalated\"}[15m])) / clamp_min(sum(rate(customer_support_questions_total[15m])), 0.001)",
          "legendFormat": "escalated",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Judges failing closed",
      "description": "Judges that gave up after retries. The leading indicator: this moves BEFORE the escalation rate, and it is the only signal that separates a provider outage from genuinely bad retrieval — downstream both look identical.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (gate) (rate(customer_support_judge_failures_total[5m]))",
          "legendFormat": "{{gate}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "piechart",
      "title": "Why questions escalate",
      "description": "Which gate sent them to a human. context_relevance dominating means retrieval; the post-generation gates mean the answer was drafted but rejected.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (failed_gate) (customer_support_questions_total{outcome=\"escalated\"})",
          "legendFormat": "{{failed_gate}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by endpoint",
      "description": "Labelled by route template, so /api/v1/chat/{thread_id} is one series rather than one per conversation.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(customer_support_requests_total[5m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency by endpoint",
      "description": "Watch /api/v1/chat/{thread_id}: it reads through the LangGraph checkpointer, which is a single connection behind a global lock.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (endpoint, le) (rate(customer_support_request_latency_seconds_bucket[5m])))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate (5xx)",
      "description": "Counted in a finally block, so unhandled exceptions appear here rather than vanishing.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(customer_support_requests_total{status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Postgres connections in use",
      "description": "The budget is max_connections=100 against 5 uvicorn workers. Worth watching before it becomes an outage.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(pg_stat_database_numbackends)",
          "legendFormat": "connections",
          "refId": "A"
        }
      ]
    }
  ]
}
